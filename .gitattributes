# Normalizar fines de línea: los scripts y configs que corren en Linux (contenedores) deben ir en LF
* text=auto
*.sh   text eol=lf
*.php  text eol=lf
*.sql  text eol=lf
*.conf text eol=lf
*.cnf  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.env.example text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.docx binary
*.pdf  binary
