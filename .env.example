# =============================================================
# Copia este archivo como .env y completa los valores.
# El .env real NUNCA se sube a GitHub (está en .gitignore).
# =============================================================

# --- MariaDB (Master) ---
MARIADB_ROOT_PASSWORD=cambia_esto

# Un usuario de BD por microservicio (cada uno solo ve su propia BD)
AUTH_DB_PASSWORD=cambia_esto
CATALOGO_DB_PASSWORD=cambia_esto
PEDIDOS_DB_PASSWORD=cambia_esto
PAGOS_DB_PASSWORD=cambia_esto

# Usuario "replicador" que usa el Slave para copiar el binlog del Master
REPLICATION_PASSWORD=cambia_esto

# --- Redis (caché del catálogo y tokens revocados) ---
REDIS_PASSWORD=cambia_esto

# --- JWT (solo auth-service firma y verifica) ---
# Cadena aleatoria larga (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Stripe (MODO PRUEBA únicamente: pk_test_... / sk_test_...) ---
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# --- URL pública de la tienda (para el enlace de seguimiento del QR) ---
# Local: http://localhost   ·   VPS: https://<dominio o IP del VPS>
APP_URL=http://localhost

# --- Solo en el VPS (producción): HTTPS con Let's Encrypt ---
# APP_URL=https://nodotec.tech
# NGINX_CONF=nginx-https.conf      (activar DESPUÉS de obtener el certificado)

# --- Opcionales: ya tienen valores de Docker por defecto en docker-compose.yml ---
# GATEWAY_PORT=80
# GATEWAY_HTTPS_PORT=443
# NGINX_CONF=nginx.conf
# DB_HOST=mariadb-master
# DB_READ_HOST=mariadb-slave
# REDIS_HOST=redis
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com
# CLOUDINARY_CARPETA=nodotec/productos
# CLIMA_CIUDAD=Santa Cruz del Quiché
# CLIMA_LAT=15.0306
# CLIMA_LON=-91.1489
# AUTH_URL=http://auth-service:8081
# CATALOGO_URL=http://catalogo-service:8082
# PEDIDOS_URL=http://pedidos-service:8083
# PAGOS_URL=http://pagos-service:8084
# NOTIFICACIONES_URL=http://notificaciones-service:8085

# --- PayPal (SANDBOX): app de developer.paypal.com ---
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx

# --- EmailJS: servicio, plantilla (variables: to_email, cliente_nombre, pedido_id, total,
#     enlace_seguimiento) y claves; activar "Allow EmailJS API for non-browser applications" ---
EMAILJS_SERVICE_ID=service_xxx
EMAILJS_TEMPLATE_ID=template_xxx
EMAILJS_PUBLIC_KEY=xxx
EMAILJS_PRIVATE_KEY=xxx

# --- Cloudinary (imágenes de productos) ---
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# --- OpenWeatherMap (clima del dashboard) ---
OPENWEATHER_API_KEY=xxx
