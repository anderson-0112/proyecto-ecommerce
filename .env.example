# =============================================================
# Copia este archivo como .env y completa los valores.
# El .env real NUNCA se sube a GitHub (está en .gitignore).
# =============================================================

# --- MariaDB (Master) ---
MARIADB_ROOT_PASSWORD=cambia_esto

# Un usuario de BD por microservicio (cada uno solo ve su propia BD)
AUTH_DB_PASSWORD=cambia_esto
CATALOGO_DB_PASSWORD=cambia_esto
PEDIDOS_DB_PASSWORD=cambia_esto
PAGOS_DB_PASSWORD=cambia_esto

# --- JWT (solo auth-service firma y verifica) ---
# Cadena aleatoria larga (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Stripe (MODO PRUEBA únicamente: pk_test_... / sk_test_...) ---
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# --- URL pública de la tienda (para el enlace de seguimiento del QR) ---
# Local: http://localhost   ·   VPS: https://<dominio o IP del VPS>
APP_URL=http://localhost

# --- Opcionales: ya tienen valores de Docker por defecto en docker-compose.yml ---
# GATEWAY_PORT=80
# DB_HOST=mariadb-master
# DB_READ_HOST=mariadb-master
# AUTH_URL=http://auth-service:8081
# CATALOGO_URL=http://catalogo-service:8082
# PEDIDOS_URL=http://pedidos-service:8083
# PAGOS_URL=http://pagos-service:8084
# NOTIFICACIONES_URL=http://notificaciones-service:8085

# --- Bloque 4 (aún no usados) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# OPENWEATHER_API_KEY=
