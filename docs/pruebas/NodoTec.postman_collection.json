      "name": "1. Catálogo público (sin registro)",
      "item": [
        {
          "name": "Listar productos (paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/catalogo/productos?pagina=1&por_pagina=12",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "catalogo",
                "productos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "12"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('20+ productos', () => pm.expect(pm.response.json().total).to.be.at.least(20));",
                  "pm.test('Imágenes en Cloudinary', () => pm.expect(pm.response.json().productos[0].imagen_url).to.include('res.cloudinary.com'));"
                ]
              }
            }
          ]
